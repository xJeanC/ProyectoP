rules_version = '2';

// Fase 0: todo denegado por defecto.
// Cada colección se abre explícitamente en fases posteriores, siempre con pruebas
// en tests/reglas que verifican tanto lo permitido como lo prohibido.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
